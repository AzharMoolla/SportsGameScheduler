{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "silbosports",
  "account_id": "81382f9b2e06bc42d9ef6e1ae2c91144",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "routes": [
    { "pattern": "silbosports.com", "custom_domain": true },
    { "pattern": "www.silbosports.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // Run first for canonical HTTP/www redirects; non-entity HTTPS requests immediately fall
    // through to the static asset binding.
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  // SUPABASE_URL + publishable (anon) key — non-secret by design (RLS-protected, already inlined
  // into the browser bundle). The Worker uses them to read public event/league rows for OG tags.
  "vars": {
    "VITE_SUPABASE_URL": "https://bgbkqxdsjnbsizwkslsr.supabase.co",
    "VITE_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_xGx8_YsoZZBCkbMrREPGug_39_9atJA",
    "SUPABASE_URL": "https://bgbkqxdsjnbsizwkslsr.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_xGx8_YsoZZBCkbMrREPGug_39_9atJA"
  }
}
